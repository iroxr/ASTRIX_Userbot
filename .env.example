# بيانات تطبيق تيليجرام من https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# نص الجلسة من الأداة tools/generate_session.py
TG_SESSION=

# رمز GitHub (Fine-grained) بصلاحية Contents: Read and write على المستودع
GITHUB_TOKEN=
# المستودع بصيغة المالك/المستودع
GITHUB_REPO=owner/repo
# فرع قاعدة البيانات (يُنشأ تلقائيًا إن لم يوجد)
GITHUB_BRANCH=database

# بادئة الأوامر الافتراضية
COMMAND_PREFIX=.
